{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:menu:allow-new",
    "core:menu:allow-popup",
    "core:resources:allow-close",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-progress-bar",
    "core:window:allow-set-title",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-start-dragging",
    "allow-get-app-state",
    "allow-save-settings",
    "allow-pick-receipts-root",
    "allow-import-service-account",
    "allow-open-key-help",
    "allow-get-rules",
    "allow-save-rules",
    "allow-period-status",
    "allow-list-periods",
    "allow-period-summary",
    "allow-create-period",
    "allow-pick-statements",
    "allow-reconcile",
    "allow-scan-receipts",
    "allow-add-statements",
    "allow-cancel-run",
    "allow-get-review",
    "allow-get-draft",
    "allow-save-draft",
    "allow-finalize",
    "allow-reopen",
    "allow-rescan-receipt",
    "allow-rescan-reimbursement",
    "allow-export-report",
    "allow-open-report",
    "allow-open-receipt",
    "allow-reveal-period",
    "allow-open-settings",
    "allow-pending-update",
    "allow-install-update",
    "allow-set-menu",
    "allow-set-menu-state",
    "allow-set-menu-item-text",
    "allow-get-appearance",
    "allow-show-alert"
  ]
}
