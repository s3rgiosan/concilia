{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Concilia",
  "version": "2.0.0",
  "identifier": "com.s3rgiosan.concilia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Concilia",
        "url": "index.html?view=main",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: receipt: http://receipt.localhost; frame-src receipt: http://receipt.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 Sérgio Santos",
    "category": "public.app-category.finance",
    "shortDescription": "Bank statement reconciliation",
    "longDescription": "Reconciles bank statement transactions against receipts and produces an Excel report.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  }
}
