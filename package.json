{
  "name": "concilia",
  "private": true,
  "version": "2.0.0-rc.1",
  "type": "module",
  "description": "Bank statement reconciliation desktop app",
  "author": "Sérgio Santos",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "symbols": "node scripts/symbols.mjs",
    "predev": "npm run symbols",
    "dev": "vite",
    "prebuild": "npm run symbols",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "pretest": "npm run symbols",
    "test": "vitest run",
    "test:legacy": "node --test tests/worker/*.test.js",
    "precoverage": "npm run symbols",
    "coverage": "vitest run --coverage",
    "pretypecheck": "npm run symbols",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "bundle:poppler": "./scripts/bundle-poppler.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "i18next": "^26.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "lucide-static": "^1.54.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  }
}
